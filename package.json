{
  "name": "systemd-ts-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "LGPL-2.1-or-later",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "change": "changeset",
    "check": "pnpm run \"/^check:.*/\"",
    "check:deps": "pin-checker --ignore-catalog",
    "check:fmt": "vp fmt --check",
    "check:vp": "vp check --no-fmt",
    "check:spelling": "cspell lint --config ./cspell.json",
    "dev": "vp run -r dev",
    "fmt": "vp fmt",
    "manpages:fetch": "node ./compatibility/systemd/fetch-manpages.ts",
    "prepare": "vp config",
    "release:publish": "changeset publish",
    "release:version": "changeset version",
    "test": "vp run -r test",
    "test:warmup": "node ./packages/systemd-ts/__scripts__/warmup-test-host.ts",
    "test:watch": "vp run -r --parallel --no-cache test:watch",
    "verify": "pnpm run check && pnpm run test && pnpm run build",
    "workflows:update": "node ./scripts/update-workflows.node.ts"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "cspell": "catalog:",
    "pin-dependencies-checker": "catalog:",
    "tar": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.10.0"
  },
  "packageManager": "pnpm@12.6.0"
}
