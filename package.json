{
  "name": "systemd-ts-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "test:warmup": "node ./__scripts__/warm-test-host.ts",
    "check": "vp check",
    "check:dependencies": "pin-checker --ignore-catalog",
    "check:spelling": "cspell lint --config ./cspell.json",
    "dev": "vp run -r dev",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "cspell": "catalog:",
    "pin-dependencies-checker": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.1.0"
  },
  "packageManager": "pnpm@11.0.9"
}
