{
  "name": "systemd-ts-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "LGPL-2.1-or-later",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "test:warmup": "node ./packages/systemd-ts/__scripts__/warmup-test-host.ts",
    "manpages:fetch": "node ./compatibility/systemd/fetch-manpages.ts",
    "check": "vp check",
    "check:dependencies": "pin-checker --ignore-catalog",
    "check:spelling": "cspell lint --config ./cspell.json",
    "dev": "vp run -r dev",
    "changeset": "changeset",
    "release": "changeset publish",
    "update-workflows": "node ./scripts/update-workflows.node.ts",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "cspell": "catalog:",
    "pin-dependencies-checker": "catalog:",
    "tar": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.6.0"
  },
  "packageManager": "pnpm@11.20.0"
}
